hlp(){
#- This Help Command
  if [ "$1x" != 'x' ]; then
    # Process help of certain file
    echo "Aliases Help";
    echo "#Processing: $1"
    filenamestr=$(find ~/aliaspak -name "alias_$1")
    echo "Help for $filenamestr"
    if [ -f "$filenamestr" ]; then
      cat $filenamestr | grep "()\|#-";
      cat $filenamestr | grep "alias" | awk 'i=index($0, "alias") {print substr($0, i+5)}' | more;
    else
      echo "File $filenamestr not found!!"
    fi
  else
    # Process help of all files as to be on source folder
    # because home does have more files
    for file in ~/aliaspak/alias_*
    do
      filename=$( basename "$file" )
      if [ ${filename} != 'alias_pack' ]; then
        echo "\n#Processing: $file"
        cat $file | grep "()\|#-";
        cat $file | grep "alias" | awk 'i=index($0, "alias") {print substr($0, i+5)}' | more;
      fi
    done
    echo "\n\n################################";
    echo "General Help";
    echo "For Specific alias help type hlp and the corresponding:";
    find ~/aliaspak/. -name "alias_*" | sed 's/.*\///';
  fi

}

# Source depending on os
echo "#Sourcing: alias_general"
source ~/aliaspak/alias_general
unameOut="$(uname -s)"
case "${unameOut}" in
    Linux*)
      machine=Linux
      echo "#Sourcing: alias_linux"
      source ~/aliaspak/alias_linux
      echo "#Sourcing: alias_docker"
      source ~/aliaspak/alias_docker
      echo "#Sourcing: alias_git"
      source ~/aliaspak/alias_git
    ;;
    Darwin*)
      machine=Mac
      echo "#Sourcing: alias_mac"
      source ~/aliaspak/alias_mac
      echo "#Sourcing: alias_docker"
      source ~/aliaspak/alias_docker
      echo "#Sourcing: alias_git"
      source ~/aliaspak/alias_git
    ;;
    CYGWIN*)
      machine=Cygwin;;
    MINGW*)
       machine=MinGw;;
    *)
       machine="UNKNOWN:${unameOut}"
esac
echo "Alias Pack Loaded for ${machine}"

# Load .env file if it exists (for environment variables and custom aliases)
if [ -f ~/aliaspak/.env ]; then
  echo "#Loading environment variables from ~/aliaspak/.env"
  source ~/aliaspak/.env

  # Sourcing .env only keeps the *last* ADDITIONAL_ALIASES=; re-read the file and
  # merge every ADDITIONAL_ALIASES= / export ADDITIONAL_ALIASES= line (in order).
  _ap_merged=
  _ap_merged_n=0
  while IFS= read -r _ap_l || [ -n "$_ap_l" ]; do
    _ap_l="${_ap_l%$'\r'}"
    [[ "$_ap_l" =~ ^[[:space:]]*# ]] && continue
    if [[ ! "$_ap_l" =~ ^[[:space:]]*export[[:space:]]+ADDITIONAL_ALIASES= ]] && \
       [[ ! "$_ap_l" =~ ^[[:space:]]*ADDITIONAL_ALIASES= ]]; then
      continue
    fi
    _ap_v="${_ap_l#*ADDITIONAL_ALIASES=}"
    case "$_ap_v" in
      \"*) _ap_v="${_ap_v#\"}"; _ap_v="${_ap_v%\"}" ;;
      \'*) _ap_v="${_ap_v#\'}"; _ap_v="${_ap_v%\'}" ;;
    esac
    [ -n "$_ap_v" ] || continue
    if [ -n "$_ap_merged" ]; then
      _ap_merged="$_ap_merged $_ap_v"
    else
      _ap_merged="$_ap_v"
    fi
    _ap_merged_n=$((_ap_merged_n + 1))
  done < ~/aliaspak/.env
  if [ "$_ap_merged_n" -gt 0 ]; then
    ADDITIONAL_ALIASES="$_ap_merged"
  fi
  unset _ap_merged _ap_merged_n

  # Source additional alias files if specified in ADDITIONAL_ALIASES
  if [ -n "$ADDITIONAL_ALIASES" ]; then
    echo "#Loading additional alias files (override mode)"
    # 1) Newlines/tabs in the value become spaces (multi-line .env).
    # 2) " ~" is turned into a newline so two ~ paths in one "word" or odd
    #    separator still become separate entries (e.g. NBSP: not in IFS).
    # 3) Each line is split on blanks with xargs -n1 (POSIX "blank" delimiters).
    # 4) awk gsub turns " ~" into newline+"~" so two ~/ paths in one token still split.
    # Process substitution keeps the while loop in this shell so source works.
    while IFS= read -r _ap_line || [ -n "$_ap_line" ]; do
      case "$_ap_line" in *[![:space:]]*) ;; *) continue;; esac
      while IFS= read -r alias_file; do
        [ -z "$alias_file" ] && continue
        # Resolve: absolute, ~/… (home-relative), or relative to ~/aliaspak/
        resolved=""
        if [[ "$alias_file" = /* ]]; then
          resolved="$alias_file"
        elif [[ "$alias_file" = ~* ]]; then
          # e.g. ~/plex/mac/alias_macpro — do not prefix with ~/aliaspak/
          resolved="${alias_file/#\~/$HOME}"
        else
          resolved="$HOME/aliaspak/$alias_file"
        fi
        if [ -f "$resolved" ]; then
          echo "#Sourcing (override): $resolved"
          source "$resolved"
        else
          echo "#Warning: Additional alias file not found: $resolved"
        fi
      done < <(printf '%s' "$_ap_line" | xargs -n1 2>/dev/null)
    done < <(printf '%s' "$ADDITIONAL_ALIASES" | tr '\n\t' '  ' | sed 's/  */ /g' | awk '{ gsub(/ ~/,"\n~") } 1')
  fi
fi

