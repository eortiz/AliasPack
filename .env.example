# AliasPak Environment Configuration
# Last modified: 2026-02-28 12:36:38 | Updated: eortiz
# Copy this file to .env and customize as needed
# Usage: cp .env.example .env

# ============================================
# Environment Variables
# ============================================
# Add any environment variables you need here

# Example: OpenAI API Key
# export OPENAI_API_KEY="sk-your-api-key-here"

# Example: Other API keys or tokens
# export GITHUB_TOKEN="ghp_your-token-here"
# export DOCKER_HUB_TOKEN="your-token-here"

# Example: Path additions
# export PATH="$HOME/bin:$PATH"

# Example: Custom environment settings
# export EDITOR="vim"
# export VISUAL="code"
# export MYUSERNAME="user"

# ============================================
# Additional Alias Files (Override System)
# ============================================
# Specify additional alias files to source AFTER the main alias files
# This allows you to override any default aliases with your own custom ones
# Files will be sourced in the order listed
# Use space-separated entries (relative to ~/aliaspak/, or ~/... / absolute paths)
# You may use several ADDITIONAL_ALIASES= lines; they are merged in file order.

# Example: two home-relative override files
# ADDITIONAL_ALIASES="~/plex/mac/alias_macpro ~/plex/mac/alias_eod"

# Example: Load custom personal and work-specific aliases
# ADDITIONAL_ALIASES="alias_custom alias_work alias_personal"

# Example: Load from absolute paths
# ADDITIONAL_ALIASES="/path/to/custom/aliases ~/.my_custom_aliases"

# Uncomment and customize:
# ADDITIONAL_ALIASES="alias_custom"
